{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@scriptfs/module": ["./packages/module/src/index.ts"],
      "@scriptfs/testing": ["./packages/testing/src/index.ts"],
      "scriptfs": ["./src/index.ts"]
    }
  },
  "include": [
    "src",
    "test",
    "packages/module/src",
    "packages/module/test",
    "packages/testing/src",
    "packages/testing/test",
    "*.ts",
    "*.js"
  ]
}
