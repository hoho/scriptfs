{
  "$schema": "../../scriptfs.schema.json",
  "modules": {
    "inbox": {
      "manifest": "./module",
      "settings": {
        "maxMessages": 50
      },
      "ports": {
        "http": { "hostPort": 18787 }
      }
    }
  },
  "filesystems": [
    {
      "name": "inbox",
      "source": "./module",
      "mountPoint": "./mount",
      "rules": [
        {
          "match": "Inbox/**",
          "root": "Inbox",
          "opaque": true,
          "provider": { "module": "inbox" }
        }
      ]
    }
  ]
}
