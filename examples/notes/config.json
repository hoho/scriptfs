{
  "$schema": "../../scriptfs.schema.json",
  "modules": {
    "notes": {
      "manifest": "./module",
      "paths": {
        "notes": "./sample-notes"
      }
    }
  },
  "filesystems": [
    {
      "name": "notes",
      "source": "./sample-notes",
      "mountPoint": "./mount",
      "readOnly": true,
      "rules": [
        {
          "match": "Notes/**",
          "root": "Notes",
          "opaque": true,
          "provider": { "module": "notes" }
        }
      ]
    }
  ]
}
